{"code":"// 此文件定义的所有Task执行的func都是绑定在Creep的prototype上的\r\n/**\r\n * 采集资源Task的包装类, 将room中所有资源转换为采集Task并返回\r\n * @param room\r\n */\r\nexport function harvestSource(room) {\r\n    const sources = room.find(FIND_SOURCES);\r\n    let tasks = [];\r\n    for (const source of sources) {\r\n        tasks.push({\r\n            taskType: 'harvestTask',\r\n            taskFunc: 'harvestSource',\r\n            taskParam: [source.id]\r\n        });\r\n    }\r\n    return tasks;\r\n}\r\nexport function upgrade(room) {\r\n    return [{\r\n            taskType: 'upgradeTask',\r\n            taskFunc: 'upgrade',\r\n            taskParam: [room.find(FIND_MY_STRUCTURES, {\r\n                    filter: { structureType: STRUCTURE_CONTROLLER }\r\n                })[0].id]\r\n        }];\r\n}\r\n//# sourceMappingURL=roomTask.js.map","references":[],"map":"{\"version\":3,\"file\":\"roomTask.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../src/task/roomTask.ts\"],\"names\":[],\"mappings\":\"AAAA,4CAA4C;AAC5C;;;GAGG;AACH,MAAM,UAAU,aAAa,CAAC,IAAU;IACpC,MAAM,OAAO,GAAG,IAAI,CAAC,IAAI,CAAC,YAAY,CAAC,CAAA;IACvC,IAAI,KAAK,GAAa,EAAE,CAAA;IACxB,KAAK,MAAM,MAAM,IAAI,OAAO,EAAE;QAC1B,KAAK,CAAC,IAAI,CAAC;YACP,QAAQ,EAAE,aAAa;YACvB,QAAQ,EAAE,eAAe;YACzB,SAAS,EAAE,CAAC,MAAM,CAAC,EAAE,CAAC;SACzB,CAAC,CAAA;KACL;IACD,OAAO,KAAK,CAAA;AAChB,CAAC;AAED,MAAM,UAAU,OAAO,CAAC,IAAU;IAC9B,OAAO,CAAC;YACJ,QAAQ,EAAE,aAAa;YACvB,QAAQ,EAAE,SAAS;YACnB,SAAS,EAAE,CAAC,IAAI,CAAC,IAAI,CAAC,kBAAkB,EAAE;oBACtC,MAAM,EAAE,EAAC,aAAa,EAAE,oBAAoB,EAAC;iBAChD,CAAC,CAAC,CAAC,CAAC,CAAC,EAAE,CAAC;SACZ,CAAC,CAAA;AACN,CAAC\"}"}
