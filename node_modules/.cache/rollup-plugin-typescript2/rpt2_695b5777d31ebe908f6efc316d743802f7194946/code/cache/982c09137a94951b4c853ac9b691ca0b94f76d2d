e);\r\n        console.log(\"123\");\r\n        Game.map.visual.line(point1, point2, { width: 0.5, color: '#ff0000' });\r\n        Game.map.visual.line(point2, point3, { width: 0.5, color: '#ff0000' });\r\n        Game.map.visual.line(point3, point4, { width: 0.5, color: '#ff0000' });\r\n        Game.map.visual.line(point4, point1, { width: 0.5, color: '#ff0000' });\r\n    }\r\n}\r\n//# sourceMappingURL=autoplan.js.map","references":[],"map":"{\"version\":3,\"file\":\"autoplan.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../../src/global/auto/autoplan.ts\"],\"names\":[],\"mappings\":\"AAAA,SAAS,eAAe,CAAC,IAAW,EAAE,IAAW;IAC7C,IAAI,KAAK,GAAG,EAAE,CAAC;IACf,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAG,IAAI,EAAE,CAAC,EAAE,EAAE;QAC3B,KAAK,CAAC,CAAC,CAAC,GAAG,EAAE,CAAC;QACd,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAG,IAAI,EAAE,CAAC,EAAE,EAAE;YAC3B,KAAK,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC;SACnB;KACJ;IACD,OAAO,KAAK,CAAC;AACjB,CAAC;AAED,MAAM,UAAU,aAAa;AAG7B,CAAC;AAED,MAAM,UAAU,gBAAgB,CAAC,SAAgB,EAAE,QAAgB;IAC/D,IAAI,SAAS,GAAG,eAAe,CAAC,EAAE,EAAE,EAAE,CAAC,CAAA;IACvC,IAAI,OAAO,GAAG,EAAE,CAAA;IAChB,IAAI,OAAO,GAAG,IAAI,IAAI,CAAC,OAAO,CAAC,QAAQ,CAAC,CAAA;IACxC,oBAAoB;IACpB,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAC,EAAE,EAAE,CAAC,EAAE,EAAE,EAAK,QAAQ;QACpC,IAAI,CAAC,CAAC,OAAO,CAAC,GAAG,CAAC,CAAC,EAAE,CAAC,CAAC,IAAI,iBAAiB,CAAC,EAAE,EAAM,QAAQ;YACzD,SAAS,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC,CAAG,cAAc;SACxC;KACJ;IACD,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAC,EAAE,EAAE,CAAC,EAAE,EAAE,EAAK,QAAQ;QACpC,IAAI,CAAC,CAAC,OAAO,CAAC,GAAG,CAAC,CAAC,EAAE,CAAC,CAAC,IAAI,iBAAiB,CAAC,EAAE,EAAM,QAAQ;YACzD,SAAS,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,CAAC,CAAG,cAAc;SACxC;KACJ;IAED,YAAY;IACZ,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAC,EAAE,EAAE,CAAC,EAAE,EAAE;QACvB,KAAK,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,GAAC,EAAE,EAAE,CAAC,EAAE,EAAE;YACvB,IAAI,CAAC,CAAC,OAAO,CAAC,GAAG,CAAC,CAAC,EAAE,CAAC,CAAC,IAAI,iBAAiB,CAAC,EAAE,EAAM,QAAQ;gBACzD,SAAS,CAAC,CAAC,CAAC,CAAC,CAAC,CAAC,GAAG,CAAC,GAAG,IAAI,CAAC,GAAG,CAA