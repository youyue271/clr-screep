{"code":"// 此文件定义的所有Task执行的func都是绑定在Creep的prototype上的\r\nimport { upgradeTaskCapacity } from \"@/setting\";\r\n/**\r\n * 采集资源Task的包装类, 将room中所有资源转换为采集Task并返回\r\n * @param room\r\n */\r\nexport function harvestSource(room) {\r\n    const sources = room.sources();\r\n    // TODO: 这里的containerPos是直接返回的数组，需要找到最近的container，大概是一个不超过4的for循环，但是也可以再优化\r\n    const containerPos = room.containerPos().map(item => {\r\n        return room.getPositionAt(item[0], item[1]);\r\n    });\r\n    let tasks = [];\r\n    for (const sourceId of sources) {\r\n        const source = Game.getObjectById(sourceId);\r\n        if (!source) {\r\n            continue;\r\n        }\r\n        const pos = source.pos.findInRange(containerPos, 1);\r\n        const targetPos = pos[0];\r\n        tasks.push({\r\n            taskType: 'harvestTask',\r\n            taskFunc: 'harvestSource',\r\n            taskParam: [sourceId, targetPos.x, targetPos.y]\r\n        });\r\n    }\r\n    return tasks;\r\n}\r\nexport function upgrade(room) {\r\n    const capacity = upgradeTaskCapacity[room.controller.level];\r\n    if (!capacity) {\r\n        return [];\r\n    }\r\n    return [{\r\n            taskType: 'upgradeTask',\r\n            taskFunc: 'upgrade',\r\n            taskParam: [room.controller.id],\r\n            capacity: capacity,\r\n            persistent: true,\r\n            targetId: room.controller.id\r\n        }];\r\n}\r\nexport function construct(ConstructionSiteId) {\r\n    return [{\r\n            taskType: 'constructTask',\r\n            taskFunc: 'construct',\r\n            taskParam: [ConstructionSiteId]\r\n        }];\r\n}\r\nexport function getContainerEnergy(room) {\r\n    const containerId = room.getContainer();\r\n    if (!containerId) {\r\n        return [];\r\n    }\r\n    else {\r\n        return [{\r\n                taskType: 'energyTask',\r\n                taskFunc: 'getEnergyFromStructure',\r\n                taskParam: [containerId, RESOURCE_ENERGY]\r\n            }];\r\n    }\r\n}\r\nexport function getResourceEnergy(room) {\r\n    const resource = room.getResources();\r\n    if (!resource) {\r\n        return [];\r\n    }\r\n    else {\r\n        return [{\r\n                taskType: 'energyTask',\r\n                taskFunc: 'collectEnergy',\r\n                taskParam: [resource.id]\r\n            }];\r\n    }\r\n}\r\nexport function getStorageEnergy(room) {\r\n    const storage = room.storage;\r\n    if (!storage) {\r\n        return [];\r\n    }\r\n    else {\r\n        return [{\r\n                taskType: 'energyTask',\r\n                taskFunc: 'getEnergyFromStructure',\r\n                taskParam: [storage.id, RESOURCE_ENERGY]\r\n            }];\r\n    }\r\n}\r\nexport function getEnergyWithStorage(room) {\r\n    let tasks = getContainerEnergy(room);\r\n    if (tasks.length) {\r\n        return tasks;\r\n    }\r\n    tasks = getResourceEnergy(room);\r\n    if (tasks.length) {\r\n        return tasks;\r\n    }\r\n    tasks = getStorageEnergy(room);\r\n    if (tasks.length) {\r\n        return tasks;\r\n    }\r\n    return [];\r\n}\r\nexport function getEnergyWithoutStorage(room) {\r\n    let tasks = getContainerEnergy(room);\r\n    if (tasks.length) {\r\n        return tasks;\r\n    }\r\n    tasks = getResourceEnergy(room);\r\n    if (tasks.length) {\r\n        return tasks;\r\n    }\r\n}\r\nexport function getCarryList(targetList, resourceType) {\r\n    return targetList.map(item => {\r\n        return {\r\n            taskType: 'carryTask',\r\n            taskFunc: \"carryEnergy\",\r\n            taskParam: [item.id, resourceType],\r\n            priority: 1,\r\n            capacity: 1,\r\n            persistent: true,\r\n            targetId: item.id\r\n        };\r\n    });\r\n}\r\nexport function createBuildTask(targetList) {\r\n    return targetList.map(item => {\r\n        return {\r\n            taskType: 'constructTask',\r\n            taskFunc: \"buildConstructionSite\",\r\n            taskParam: [item.id]\r\n        };\r\n    });\r\n}\r\n//# sourceMappingURL=roomTask.js.map","references":["D:/project/screeps/clr screep/src/setting.ts"],"map":"{\"version\":3,\"file\":\"roomTask.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../src/task/roomTask.ts\"],\"names\":[],\"mappings\":\"AAAA,4CAA4C;AAC5C,OAAO,EAAC,mBAAmB,EAAC,MAAM,WAAW,CAAC;AAE9C;;;GAGG;AACH,MAAM,UAAU,aAAa,CAAC,IAAU;IACpC,MAAM,OAAO,GAAG,IAAI,CAAC,OAAO,EAAE,CAAA;IAC9B,0EAA0E;IAC1E,MAAM,YAAY,GAAG,IAAI,CAAC,YAAY,EAAE,CAAC,GAAG,CAAC,IAAI,CAAC,EAAE;QAChD,OAAO,IAAI,CAAC,aAAa,CAAC,IAAI,CAAC,CAAC,CAAC,EAAE,IAAI,CAAC,CAAC,CAAC,CAAC,CAAA;IAC/C,CAAC,CAAC,CAAA;IACF,IAAI,KAAK,GAAa,EAAE,CAAA;IACxB,KAAK,MAAM,QAAQ,IAAI,OAAO,EAAE;QAC5B,MAAM,MAAM,GAAG,IAAI,CAAC,aAAa,CAAS,QAAQ,CAAC,CAAA;QACnD,IAAI,CAAC,MAAM,EAAE;YACT,SAAQ;SACX;QACD,MAAM,GAAG,GAAG,MAAM,CAAC,GAAG,CAAC,WAAW,CAAC,YAAY,EAAE,CAAC,CAAC,CAAA;QACnD,MAAM,SAAS,GAAG,GAAG,CAAC,CAAC,CAAC,CAAA;QACxB,KAAK,CAAC,IAAI,CAAC;YACP,QAAQ,EAAE,aAAa;YACvB,QAAQ,EAAE,eAAe;YACzB,SAAS,EAAE,CAAC,QAAQ,EAAE,SAAS,CAAC,CAAC,EAAE,SAAS,CAAC,CAAC,CAAC;SAClD,CAAC,CAAA;KACL;IACD,OAAO,KAAK,CAAA;AAChB,CAAC;AAED,MAAM,UAAU,OAAO,CAAC,IAAU;IAC9B,MAAM,QAAQ,GAAG,mBAAmB,CAAC,IAAI,CAAC,UAAU,CAAC,KAAK,CAAC,CAAA;IAC3D,IAAI,CAAC,QAAQ,EAAE;QACX,OAAO,EAAE,CAAA;KACZ;IACD,OAAO,CAAC;YACJ,QAAQ,EAAE,aAAa;YACvB,QAAQ,EAAE,SAAS;YACnB,SAAS,EAAE,CAAC,IAAI,CAAC,UAAU,CAAC,EAAE,CAAC;YAC/B,QAAQ,EAAE,QAAQ;YAClB,UAAU,EAAE,IAAI;YAChB,QAAQ,EAAE,IAAI,CAAC,UAAU,CAAC,EAAE;SAC/B,CAAC,CAAA;AACN,CAAC;AAED,MAAM,UAAU,SAAS,CAAC,kBAAuB;IAC7C,OAAO,CAAC;YACJ,QAAQ,EAAE,eAAe;YACzB,QAAQ,EAAE,WAAW;YACrB,SAAS,EAAE,CAAC,kBAAkB,CAAC;SAClC,CAAC,CAAA;AACN,CAAC;AAED,MAAM,UAAU,kBAAkB,CAAC,IAAU;IACzC,MAAM,WAAW,GAAG,IAAI,CAAC,YAAY,EAAE,CAAA;IACvC,IAAG,CAAC,WAAW,EAAC;QACZ,OAAO,EAAE,CAAA;KACZ;SAAM;QACH,OAAO,CAAC;gBACJ,QAAQ,EAAE,YAAY;gBACtB,QAAQ,EAAE,wBAAwB;gBAClC,SAAS,EAAE,CAAC,WAAW,EAAE,eAAe,CAAC;aAC5C,CAAC,CAAA;KACL;AAEL,CAAC;AAED,MAAM,UAAU,iBAAiB,CAAC,IAAU;IACxC,MAAM,QAAQ,GAAG,IAAI,CAAC,YAAY,EAAE,CAAA;IACpC,IAAI,CAAC,QAAQ,EAAE;QACX,OAAO,EAAE,CAAA;KACZ;SAAM;QACH