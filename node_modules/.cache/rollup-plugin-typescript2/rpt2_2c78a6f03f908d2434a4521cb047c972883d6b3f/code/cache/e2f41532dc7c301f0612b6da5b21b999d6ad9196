{"code":"class logger {\r\n    constructor() {\r\n        this.levels = {\r\n            \"DEBUG\": 1,\r\n            \"INFO\": 2,\r\n            \"WARNING\": 3,\r\n            \"ERROR\": 4,\r\n            \"CONSOLE\": 5\r\n        };\r\n        this.currentLevel = this.levels[\"DEBUG\"]; // 设置默认日志级别为 DEBUG\r\n    }\r\n    setLevel(level) {\r\n        if (level in this.levels) {\r\n            this.currentLevel = this.levels[level];\r\n        }\r\n        else {\r\n            console.error(`Invalid log level: ${level}`);\r\n        }\r\n    }\r\n    log(level, content, prefixes = [], color = null, notify = false) {\r\n        if (level >= this.currentLevel) {\r\n            // 有前缀就组装在一起\r\n            let prefix = prefixes.length > 0 ? `${prefixes.join(' ')}` : '';\r\n            // 指定了颜色\r\n            prefix = colorful(prefix, color, true);\r\n            content = colorful(content, color);\r\n            const logContent = `${prefix}${content}`;\r\n            console.log(logContent);\r\n            // 转发到邮箱\r\n            if (notify)\r\n                Game.notify(logContent);\r\n        }\r\n    }\r\n    debug(message) {\r\n        this.log(this.levels['DEBUG'], message, [\"DEBUG \"], 'white');\r\n    }\r\n    info(message) {\r\n        this.log(this.levels['INFO'], message, [\"+ \"], 'blue');\r\n    }\r\n    warning(message) {\r\n        this.log(this.levels['WARNING'], message, [\"\"], 'yellow');\r\n    }\r\n    error(message) {\r\n        this.log(this.levels['ERROR'], message, [\"- \"], \"red\");\r\n    }\r\n}\r\nfunction colorful(content, colorName = null, bolder = false) {\r\n    const colorStyle = colorName ? `color: ${colors[colorName]};` : '';\r\n    const bolderStyle = bolder ? 'font-weight: bolder;' : '';\r\n    return `<text style=\"${[colorStyle, bolderStyle].join(' ')}\">${content}</text>`;\r\n}\r\nconst colors = {\r\n    red: '#ef9a9a',\r\n    green: '#6b9955',\r\n    yellow: '#c5c599',\r\n    blue: '#8dc5e3',\r\n    white: '#f7f9f7'\r\n};\r\n/**\r\n * 生成控制台链接\r\n * @param content 要显示的内容\r\n * @param url 要跳转到的 url\r\n * @param newTab 是否在新标签页打开\r\n */\r\nexport function createLink(content, url, newTab = true) {\r\n    return `<a href=\"${url}\" target=\"${newTab ? '_blank' : '_self'}\">${content}</a>`;\r\n}\r\n/**\r\n * 给房间内添加跳转链接\r\n *\r\n * @param roomName 添加调整链接的房间名\r\n * @returns 打印在控制台上后可以点击跳转的房间名\r\n */\r\nexport function createRoomLink(roomName) {\r\n    return createLink(roomName, `https://screeps.com/a/#!/room/${Game.shard.name}/${roomName}`, false);\r\n}\r\nconst loggerInstance = new logger();\r\nexport default loggerInstance;\r\n//# sourceMappingURL=log.js.map","references":[],"map":"{\"version\":3,\"file\":\"log.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../src/util/log.ts\"],\"names\":[],\"mappings\":\"AAAA,MAAM,MAAM;IAUR;QARA,WAAM,GAAG;YACL,OAAO,EAAE,CAAC;YACV,MAAM,EAAE,CAAC;YACT,SAAS,EAAE,CAAC;YACZ,OAAO,EAAE,CAAC;YACV,SAAS,EAAE,CAAC;SACf,CAAC;QAGE,IAAI,CAAC,YAAY,GAAG,IAAI,CAAC,MAAM,CAAC,OAAO,CAAC,CAAC,CAAC,kBAAkB;IAChE,CAAC;IAED,QAAQ,CAAC,KAAa;QAClB,IAAI,KAAK,IAAI,IAAI,CAAC,MAAM,EAAE;YACtB,IAAI,CAAC,YAAY,GAAG,IAAI,CAAC,MAAM,CAAC,KAAK,CAAC,CAAC;SAC1C;aAAM;YACH,OAAO,CAAC,KAAK,CAAC,sBAAsB,KAAK,EAAE,CAAC,CAAC;SAChD;IACL,CAAC;IAED,GAAG,CAAC,KAAa,EAAE,OAAe,EAAE,WAAqB,EAAE,EAAE,QAAgB,IAAI,EAAE,SAAkB,KAAK;QAEtG,IAAI,KAAK,IAAI,IAAI,CAAC,YAAY,EAAE;YAC5B,YAAY;YACZ,IAAI,MAAM,GAAG,QAAQ,CAAC,MAAM,GAAG,CAAC,CAAC,CAAC,CAAC,GAAG,QAAQ,CAAC,IAAI,CAAC,GAAG,CAAC,EAAE,CAAC,CAAC,CAAC,EAAE,CAAA;YAC/D,QAAQ;YACR,MAAM,GAAG,QAAQ,CAAC,MAAM,EAAE,KAAK,EAAE,IAAI,CAAC,CAAA;YACtC,OAAO,GAAG,QAAQ,CAAC,OAAO,EAAE,KAAK,CAAC,CAAA;YAElC,MAAM,UAAU,GAAG,GAAG,MAAM,GAAG,OAAO,EAAE,CAAA;YACxC,OAAO,CAAC,GAAG,CAAC,UAAU,CAAC,CAAA;YACvB,QAAQ;YACR,IAAI,MAAM;gBAAE,IAAI,CAAC,MAAM,CAAC,UAAU,CAAC,CAAA;SACtC;IACL,CAAC;IAED,KAAK,CAAC,OAAe;QACjB,IAAI,CAAC,GAAG,CAAC,IAAI,CAAC,MAAM,CAAC,OAAO,CAAC,EAAE,OAAO,EAAE,CAAC,QAAQ,CAAC,EAAE,OAAO,CAAC,CAAC;IACjE,CAAC;IAED,IAAI,CAAC,OAAe;QAChB,IAAI,CAAC,GAAG,CAAC,IAAI,CAAC,MAAM,CAAC,MAAM,CAAC,EAAE,OAAO,E