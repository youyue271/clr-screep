{"code":"import log from \"@/util/log\";\r\nimport { getCarryList, getEnergyWithStorage } from \"@/task/roomTask\";\r\nconst roleToTask = {\r\n    'harvester': ['harvestTask'],\r\n    'worker': ['upgradeTask', 'constructTask'],\r\n    'emptyWorker': ['energyTask'],\r\n    'carrier': ['carryTask'],\r\n};\r\nexport default class CreepExtension extends Creep {\r\n    /**\r\n     * 在编写work函数的时候需要注意working标志和res返回的结果\r\n     * res返回的结果表示此回合还需不需要继续\r\n     * working的结果表示工作做完了没有\r\n     * 因为creep的res的OK表示纳入计划, 最后在回合结束时统一结算, 所以会出现,工作做完了,但是这个回合不需要继续的情况\r\n     */\r\n    work() {\r\n        // console.log(this.name)\r\n        if (this.spawning) {\r\n            // console.log(this.ticksToLive)\r\n            return;\r\n        }\r\n        if (!this.memory.role) {\r\n            log.error(this.name + \" ERROR!\");\r\n            this.remember();\r\n            return;\r\n        }\r\n        if (!this.memory.working) {\r\n            if (!this.getWork()) {\r\n                // no work in workList, try change role\r\n                if (this.memory.oldRole) {\r\n                    this.changeRole(this.memory.oldRole);\r\n                    delete this.memory.oldRole;\r\n                }\r\n                return;\r\n            }\r\n        }\r\n        // already get work, now working\r\n        const res = this[this.memory.currentWork.taskFunc](...this.memory.currentWork.taskParam);\r\n        // console.log(res, this.memory.currentWork.taskFunc, ...this.memory.currentWork.taskParam)\r\n        if (!res) {\r\n            // still working\r\n            return;\r\n        }\r\n        else {\r\n            // work over, get another work\r\n            this.memory.working = false;\r\n            this.memory.currentWork = undefined;\r\n            this.memory.currentWorkType = undefined;\r\n            this.work();\r\n            return;\r\n        }\r\n    }\r\n    getWork() {\r\n        const room = this.room;\r\n        const TaskList = roleToTask[this.memory.role];\r\n        for (const task of TaskList) {\r\n            console.log(task, global.room[this.room.name].creepTask[task]);\r\n            if (global.room[this.room.name].creepTask[task].length > 0) {\r\n                this.memory.currentWork = global.room[this.room.name].creepTask[task].shift();\r\n                this.memory.currentWorkType = task;\r\n                this.memory.working = true;\r\n                return true;\r\n            }\r\n        }\r\n        return false;\r\n    }\r\n    changeRole(role) {\r\n        if (this.memory.currentWorkType) {\r\n            // 被丢下的工作放在队列最前面, 优先被其他creep选取\r\n            global.room[this.room.name].creepTask[this.memory.currentWorkType].unshift(this.memory.currentWork);\r\n            this.memory.currentWorkType = undefined;\r\n            this.memory.currentWork = undefined;\r\n        }\r\n        this.memory.oldRole = this.memory.role;\r\n        this.memory.role = role;\r\n        this.memory.working = false;\r\n        return true;\r\n    }\r\n    harvestSource(sourceId, containerPosX, ContainerPosY) {\r\n        const source = Game.getObjectById(sourceId);\r\n        this.say(\"⛏️007采矿\");\r\n        if (!this.pos.inRangeTo(containerPosX, ContainerPosY, 0)) {\r\n            this.moveTo(containerPosX, ContainerPosY, { visualizePathStyle: { stroke: '#ffffff' } });\r\n        }\r\n        else {\r\n            this.harvest(source);\r\n        }\r\n        return false;\r\n    }\r\n    getEnergyFromStructure(id, energyType) {\r\n        const structure = Game.getObjectById(id);\r\n        this.say(\"🫳偷拿资源\");\r\n        const res = this.withdraw(structure, energyType);\r\n        if (res == ERR_NOT_IN_RANGE) {\r\n            this.moveTo(structure, { visualizePathStyle: { stroke: '#ffff00' } });\r\n        }\r\n        else if (res == OK) {\r\n            delete this.memory.currentWorkType;\r\n            delete this.memory.currentWork;\r\n            this.changeRole(this.memory.oldRole);\r\n            delete this.memory.oldRole;\r\n        }\r\n        return false;\r\n    }\r\n    collectEnergy(id) {\r\n        const resource = Game.getObjectById(id);\r\n        if (!resource) {\r\n            delete this.memory.currentWorkType;\r\n            delete this.memory.currentWork;\r\n            this.changeRole(this.memory.oldRole);\r\n            delete this.memory.oldRole;\r\n            return true;\r\n        }\r\n        this.say(\"🫳捡资源去\");\r\n        const res = this.pickup(resource);\r\n        console.log(res);\r\n        if (res == ERR_NOT_IN_RANGE) {\r\n            this.moveTo(resource, { visualizePathStyle: { stroke: '#ffff00' } });\r\n            return false;\r\n        }\r\n        else if (res == OK) {\r\n            if (resource.amount > 150) {\r\n                if (!global.room[this.room.name].resources) {\r\n                    global.room[this.room.name].resources = [];\r\n                }\r\n                global.room[this.room.name].resources.unshift(resource);\r\n            }\r\n            delete this.memory.currentWorkType;\r\n            delete this.memory.currentWork;\r\n            this.changeRole(this.memory.oldRole);\r\n            delete this.memory.oldRole;\r\n        }\r\n        return false;\r\n    }\r\n    upgrade(controllerId) {\r\n        const controller = Game.getObjectById(controllerId);\r\n        if (this.store['energy']) {\r\n            this.say(\"⚡升本!\");\r\n            if (this.upgradeController(this.room.controller) == ERR_NOT_IN_RANGE) {\r\n                this.moveTo(this.room.controller, { visualizePathStyle: { stroke: '#ffffff' } });\r\n            }\r\n        }\r\n        else {\r\n            this.changeRole('emptyWorker');\r\n            this.room.registTask(getEnergyWithStorage(this.room));\r\n            return true;\r\n        }\r\n        return false;\r\n    }\r\n    remember() {\r\n        let a = this.name.lastIndexOf(\"r\");\r\n        this.memory.role = this.name.slice(0, a + 1);\r\n        this.memory.working = false;\r\n        this.memory.spawnRoom = this.room.name;\r\n        this.memory.reSpawn = false;\r\n        // console.log(name)\r\n    }\r\n    carryEnergy(targetId, resourceType) {\r\n        if (this.store['energy']) {\r\n            this.say(\"⚡运输中\");\r\n            const target = Game.getObjectById(targetId);\r\n            const res = this.transfer(target, resourceType);\r\n            if (res == ERR_NOT_IN_RANGE) {\r\n                this.moveTo(target, { visualizePathStyle: { stroke: '#ffffff' } });\r\n                return false;\r\n            }\r\n            else if (res == OK) {\r\n                // TODO: 这里后面还有修改成集群采集判断\r\n                if (target.store.getFreeCapacity(resourceType)) {\r\n                    this.room.registTask(getCarryList([target], resourceType));\r\n                }\r\n                return false;\r\n            }\r\n        }\r\n        else {\r\n            this.changeRole('emptyWorker');\r\n            this.room.registTask(getEnergyWithStorage(this.room));\r\n            return true;\r\n        }\r\n        return false;\r\n    }\r\n    buildConstructionSite(constructionId) {\r\n        if (this.store['energy']) {\r\n            this.say(\"⚡建造中\");\r\n            const target = Game.getObjectById(constructionId);\r\n            const res = this.build(target);\r\n            if (res == ERR_NOT_IN_RANGE) {\r\n                this.moveTo(target, { visualizePathStyle: { stroke: '#ffffff' } });\r\n                return false;\r\n            }\r\n            else if (res == OK) {\r\n                // 建成以后下一tick执行onBuild\r\n                // this.room.registEvent({\r\n                //     triggerTime: Game.time + 1,\r\n                //     triggerFunc: \"buildOver\",\r\n                //     param: [target.pos.x, target.pos.y]\r\n                // })\r\n                return false;\r\n            }\r\n            else {\r\n                this.room.buildOver(target.pos.x, target.pos.y);\r\n                return true;\r\n            }\r\n        }\r\n        else {\r\n            this.changeRole('emptyWorker');\r\n            this.room.registTask(getEnergyWithStorage(this.room));\r\n            return true;\r\n        }\r\n    }\r\n}\r\n//# sourceMappingURL=extension.js.map","references":["E:/STEVE/project/screeps/clr screep/src/util/log.ts","E:/STEVE/project/screeps/clr screep/src/task/roomTask.ts"],"map":"{\"version\":3,\"file\":\"extension.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../../src/mount/creep/extension.ts\"],\"names\":[],\"mappings\":\"AAAA,OAAO,GAAG,MAAM,YAAY,CAAC;AAC7B,OAAO,EAAC,YAAY,EAAE,oBAAoB,EAAC,MAAM,iBAAiB,CAAC;AAEnE,MAAM,UAAU,GAAmC;IAC/C,WAAW,EAAE,CAAC,aAAa,CAAC;IAC5B,QAAQ,EAAE,CAAC,aAAa,EAAE,eAAe,CAAC;IAC1C,aAAa,EAAE,CAAC,YAAY,CAAC;IAC7B,SAAS,EAAE,CAAC,WAAW,CAAC;CAC3B,CAAA;AAED,MAAM,CAAC,OAAO,OAAO,cAAe,SAAQ,KAAK;IAE7C;;;;;OAKG;IACH,IAAI;QACA,yBAAyB;QACzB,IAAI,IAAI,CAAC,QAAQ,EAAE;YACf,gCAAgC;YAChC,OAAM;SACT;QACD,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,IAAI,EAAE;YACnB,GAAG,CAAC,KAAK,CAAC,IAAI,CAAC,IAAI,GAAG,SAAS,CAAC,CAAA;YAChC,IAAI,CAAC,QAAQ,EAAE,CAAA;YACf,OAAM;SACT;QACD,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,OAAO,EAAE;YACtB,IAAI,CAAC,IAAI,CAAC,OAAO,EAAE,EAAE;gBACjB,uCAAuC;gBACvC,IAAI,IAAI,CAAC,MAAM,CAAC,OAAO,EAAE;oBACrB,IAAI,CAAC,UAAU,CAAC,IAAI,CAAC,MAAM,CAAC,OAAO,CAAC,CAAA;oBACpC,OAAO,IAAI,CAAC,MAAM,CAAC,OAAO,CAAA;iBAC7B;gBACD,OAAM;aACT;SACJ;QAGD,gCAAgC;QAChC,MAAM,GAAG,GAAG,IAAI,CAAC,IAAI,CAAC,MAAM,CAAC,WAAW,CAAC,QAAQ,CAAC,CAAC,GAAG,IAAI,CAAC,MAAM,CAAC,WAAW,CAAC,SAAS,CAAC,CAAC;QACzF,2FAA2F;QAC3F,IAAI,CAAC,GAAG,EAAE;YACN,gBAAgB;YAChB,OAAM;SACT;aAAM;YACH,8BAA8B;YAC9B,IAAI,CAAC,MAAM,CAAC,OAAO,GAAG,KAAK,CAAA;YAC3B,IAAI,CAAC,MAAM,CAAC,WAAW,GAAG,SAAS,CAAA;YACnC,IAAI,CAAC,MAAM,CAAC,eAAe,GAAG,SAAS,CAAA;YACvC,IAAI,CAAC,IAAI,EAAE,CAAA;YACX,OAAM;SACT;IACL,CAAC;IAGD,OAAO;QACH,MAAM,IAAI,GAAG,IAAI,CAAC,IAAI,CAAA;QACtB,MAAM,QAAQ,GAAG,UAAU,CAAC,IAAI,CAAC,MAAM,CAAC,IAAI,CAAC,CAAA;QAC7C,KAAK,MAAM,IAAI,IAAI,QAAQ,EAAE;YACzB,OAAO,CAAC,GAAG,CAAC,IAAI,EAAE,MAAM,CAAC,IAAI,CAAC,IAAI,CAAC,IAA