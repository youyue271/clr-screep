{"code":"import { spawnPercent } from \"@/setting\";\r\n/**\r\n * 把 obj2 的原型合并到 obj1 的原型上\r\n * 如果原型的键以 Getter 结尾，则将会把其挂载为 getter 属性\r\n * @param obj1 要挂载到的对象\r\n * @param obj2 要进行挂载的对象\r\n */\r\nexport const assignPrototype = function (obj1, obj2) {\r\n    Object.getOwnPropertyNames(obj2.prototype).forEach(key => {\r\n        if (key.includes('Getter')) {\r\n            Object.defineProperty(obj1.prototype, key.split('Getter')[0], {\r\n                get: obj2.prototype[key],\r\n                enumerable: false,\r\n                configurable: true\r\n            });\r\n        }\r\n        else\r\n            obj1.prototype[key] = obj2.prototype[key];\r\n    });\r\n};\r\n/**\r\n * 根据身体配置生成完成的身体数组\r\n * cpu 消耗: 0.028 左右\r\n *\r\n * @param bodySet 身体部件配置对象\r\n */\r\nexport function calcBodyPart(bodySet) {\r\n    // 把身体配置项拓展成如下形式的二维数组\r\n    // [ [ TOUGH ], [ WORK, WORK ], [ MOVE, MOVE, MOVE ] ]\r\n    const bodys = Object.keys(bodySet).map(type => Array(bodySet[type]).fill(type));\r\n    // 把二维数组展平\r\n    return [].concat(...bodys);\r\n}\r\nexport function CalBodyCost(bodys) {\r\n    let cost = 0;\r\n    if (!bodys) {\r\n        console.log(\"怎么会有空的bodys？\");\r\n        return;\r\n    }\r\n    for (let body of bodys) {\r\n        cost += BODYPART_COST[body];\r\n    }\r\n    return cost;\r\n}\r\n/**\r\n *\r\n * @param role\r\n * @param room\r\n */\r\nexport function getBody(role, room) {\r\n    switch (role) {\r\n        case 'harvester':\r\n            return getHarvesterBody(room);\r\n        case 'carrier':\r\n            return getCarrierBody(room);\r\n        case 'worker':\r\n            return getWorkerBody(room);\r\n        case 'claimer':\r\n            return getClaimerBody(room);\r\n        case 'attacker':\r\n            return getAttackerBody(room);\r\n        case 'viewer':\r\n            return getViewerBody(room);\r\n        case 'remoteBuilder':\r\n            return getWorkerBody(room);\r\n    }\r\n}\r\n/**\r\n //  * 返回harvester的body\r\n //  * @param room\r\n //  * @returns\r\n //  */\r\nconst getHarvesterBody = function (room) {\r\n    let body = [];\r\n    // 如果没有能量直接返回，不然后面会出现负数\r\n    // if (room.energyAvailable <= 250) return body\r\n    // if (room.workingCreepNum('harvester') == 0) {\r\n    body = calcBodyPart({ [MOVE]: 1, [WORK]: 2, [CARRY]: 1 });\r\n    // } else {\r\n    //     let num = Math.floor((room.energyCapacityAvailable * spawnPercent - 50) / 250)\r\n    //     if (num > 3) num = 3\r\n    //     if (num <= 0) num = 1\r\n    //     body = calcBodyPart({[CARRY]: 1, [WORK]: 2 * num, [MOVE]: num})\r\n    // }\r\n    return body;\r\n};\r\nconst getCarrierBody = function (room) {\r\n    let body;\r\n    // if (room.workingCreepNum('carrier') <= 1) {\r\n    //     let num = Math.floor(room.energyAvailable / 300)\r\n    //     if (num <= 0) num = 1\r\n    //     if (num > 8) num = 8\r\n    body = calcBodyPart({ [MOVE]: 3, [CARRY]: 3 });\r\n    // } else {\r\n    //     let num = Math.floor((room.energyCapacityAvailable * spawnPercent) / 100)\r\n    //     if (num > 25) num = 25\r\n    //     if (num <= 0) num = 1\r\n    //     body = calcBodyPart({[CARRY]: num, [MOVE]: num})\r\n    // }\r\n    return body;\r\n};\r\nconst getWorkerBody = function (room) {\r\n    let body;\r\n    let num = Math.floor((room.energyCapacityAvailable * spawnPercent - 150) / 150);\r\n    if (num > 23)\r\n        num = 23;\r\n    if (num <= 0)\r\n        num = 1;\r\n    body = calcBodyPart({ [CARRY]: 3, [WORK]: num, [MOVE]: num });\r\n    return body;\r\n};\r\nconst getClaimerBody = function (room) {\r\n    let body;\r\n    let num = Math.floor((room.energyCapacityAvailable * spawnPercent) / 750);\r\n    if (num > 12)\r\n        num = 12;\r\n    if (num <= 0)\r\n        num = 1;\r\n    body = calcBodyPart({ [CLAIM]: num, [MOVE]: num * 3 });\r\n    return body;\r\n};\r\nconst getAttackerBody = function (room) {\r\n    let body;\r\n    let num = Math.floor((room.energyCapacityAvailable * spawnPercent) / 200);\r\n    if (num