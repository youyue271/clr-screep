{"code":"// 此文件定义的所有Task执行的func都是绑定在Creep的prototype上的\r\nimport { upgradeTaskCapacity } from \"@/setting\";\r\n/**\r\n * 采集资源Task的包装类, 将room中所有资源转换为采集Task并返回\r\n * @param room\r\n */\r\nexport function harvestSource(room) {\r\n    const sources = room.sources();\r\n    // TODO: 这里的containerPos是直接返回的数组，需要找到最近的container，大概是一个不超过4的for循环，但是也可以再优化\r\n    const containerPos = room.containerPos().map(item => {\r\n        return room.getPositionAt(item[0], item[1]);\r\n    });\r\n    let tasks = [];\r\n    for (const sourceId of sources) {\r\n        const source = Game.getObjectById(sourceId);\r\n        if (!source) {\r\n            continue;\r\n        }\r\n        const pos = source.pos.findInRange(containerPos, 1);\r\n        const targetPos = pos[0];\r\n        tasks.push({\r\n            taskType: 'harvestTask',\r\n            taskFunc: 'harvestSource',\r\n            taskParam: [sourceId, targetPos.x, targetPos.y]\r\n        });\r\n    }\r\n    return tasks;\r\n}\r\nexport function upgrade(room) {\r\n    const capacity = upgradeTaskCapacity[room.controller.level];\r\n    if (!capacity) {\r\n        return [];\r\n    }\r\n    return [{\r\n            taskType: 'upgradeTask',\r\n            taskFunc: 'upgrade',\r\n            taskParam: [room.controller.id],\r\n            capacity: capacity,\r\n            persistent: true,\r\n            targetId: room.controller.id\r\n        }];\r\n}\r\nexport function construct(ConstructionSiteId) {\r\n    return [{\r\n            taskType: 'constructTask',\r\n            taskFunc: 'construct',\r\n            taskParam: [ConstructionSiteId]\r\n        }];\r\n}\r\nexport function getContainerEnergy(room) {\r\n    const containerIds = room.getContainer();\r\n    if (!containerIds) {\r\n        return [];\r\n    }\r\n    else {\r\n        return containerIds.map(containerId => ({\r\n            taskType: 'energyTask',\r\n            taskFunc: 'getEnergyFromStructure',\r\n            priority: 2,\r\n            taskParam: [containerId, RESOURCE_ENERGY]\r\n        }));\r\n    }\r\n}\r\nexport function getResourceEnergy(room) {\r\n    const resources = room.getResources();\r\n    if (!resources) {\r\n        return [];\r\n    }\r\n    else {\r\n        return resources.map(resource => ({\r\n            taskType: 'energyTask',\r\n            taskFunc: 'collectEnergy',\r\n            priority: 1,\r\n            taskParam: [resource.id]\r\n        }));\r\n    }\r\n}\r\nexport function getStorageEnergy(room) {\r\n    const storage = room.storage;\r\n    console.log(room.storage);\r\n    if (!storage) {\r\n        return [];\r\n    }\r\n    else {\r\n        return [{\r\n                taskType: 'energyTask',\r\n                taskFunc: 'getEnergyFromStructure',\r\n                priority: 3,\r\n                taskParam: [storage.id, RESOURCE_ENERGY]\r\n            }];\r\n    }\r\n}\r\nexport function getTombstoneEnergy(room) {\r\n    const tombstones = room.find(FIND_TOMBSTONES);\r\n    if (!tombstones) {\r\n        return [];\r\n    }\r\n    else {\r\n        return tombstones.map(tombstone => ({\r\n            taskType: 'energyTask',\r\n            taskFunc: 'getEnergyFromStructure',\r\n            priority: 3,\r\n            taskParam: [tombstone.id, RESOURCE_ENERGY]\r\n        }));\r\n    }\r\n}\r\nexport function getEnergyTask(room) {\r\n    let containTasks = getContainerEnergy(room);\r\n    let resourceTasks = getResourceEnergy(room);\r\n    let storageTasks = getStorageEnergy(room);\r\n    let tombstonesTasks = getTombstoneEnergy(room);\r\n    return [...containTasks, ...resourceTasks, ...storageTasks, ...tombstonesTasks];\r\n}\r\n// export function getEnergyWithStorage(room: Room): MyTask[] {\r\n//     let tasks = getContainerEnergy(room)\r\n//     if (tasks.length) {\r\n//         return tasks\r\n//     }\r\n//     tasks = getResourceEnergy(room)\r\n//     if (tasks.length) {\r\n//         return tasks\r\n//     }\r\n//     tasks = getStorageEnergy(room)\r\n//     if (tasks.length) {\r\n//         return tasks\r\n//     }\r\n//     return []\r\n// }\r\n// export function getEnergyWithoutStorage(room:Room): MyTask[] {\r\n//     let tasks = getContainerEnergy(room)\r\n//     if (tasks.length) {\r\n//         return tasks\r\n//     }\r\n//     tasks = getResourceEnergy(room)\r\n//     if (tasks.length) {\r\n//         return tasks\r\n//     }\r\n// }\r\nexport function getCarryList(targetList, resourceType) {\r\n    return targetList.map(item => {\r\n        return {\r\n            taskType: 'carryTask',\r\n            taskFunc: \"carryEnergy\",\r\n            taskParam: [item.id, resourceType],\r\n            priority: 1,\r\n            capacity: 1,\r\n            persistent: true,\r\n            targetId: item.id\r\n        };\r\n    });\r\n}\r\nexport function createBuildTask(targetList) {\r\n    return targetList.map(item => {\r\n        return {\r\n            taskType: 'constructTask',\r\n            taskFunc: \"buildConstructionSite\",\r\n            taskParam: [item.id]\r\n        };\r\n    });\r\n}\r\n//# sourceMappingURL=roomTask.js.map","references":["D:/project/screeps/clr screep/src/setting.ts"],"map":"{\"version\":3,\"file\":\"roomTask.js\",\"sourceRoot\":\"\",\"sources\":[\"../../../../../src/task/roomTask.ts\"],\"names\":[],\"mappings\":\"AAAA,4CAA4C;AAC5C,OAAO,EAAC,mBAAmB,EAAC,MAAM,WAAW,CAAC;AAE9C;;;GAGG;AACH,MAAM,UAAU,aAAa,CAAC,IAAU;IACpC,MAAM,OAAO,GAAG,IAAI,CAAC,OAAO,EAAE,CAAA;IAC9B,0EAA0E;IAC1E,MAAM,YAAY,GAAG,IAAI,CAAC,YAAY,EAAE,CAAC,GAAG,CAAC,IAAI,CAAC,EAAE;QAChD,OAAO,IAAI,CAAC,aAAa,CAAC,IAAI,CAAC,CAAC,CAAC,EAAE,IAAI,CAAC,CAAC,CAAC,CAAC,CAAA;IAC/C,CAAC,CAAC,CAAA;IACF,IAAI,KAAK,GAAa,EAAE,CAAA;IACxB,KAAK,MAAM,QAAQ,IAAI,OAAO,EAAE;QAC5B,MAAM,MAAM,GAAG,IAAI,CAAC,aAAa,CAAS,QAAQ,CAAC,CAAA;QACnD,IAAI,CAAC,MAAM,EAAE;YACT,SAAQ;SACX;QACD,MAAM,GAAG,GAAG,MAAM,CAAC,GAAG,CAAC,WAAW,CAAC,YAAY,EAAE,CAAC,CAAC,CAAA;QACnD,MAAM,SAAS,GAAG,GAAG,CAAC,CAAC,CAAC,CAAA;QACxB,KAAK,CAAC,IAAI,CAAC;YACP,QAAQ,EAAE,aAAa;YACvB,QAAQ,EAAE,eAAe;YACzB,SAAS,EAAE,CAAC,QA